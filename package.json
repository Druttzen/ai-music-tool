{
  "name": "ai-music-tool",
  "version": "0.50.27",
  "description": "AI Music Creator — Suno prompts, local track analyzer, EBU R128 LUFS meter, and studio WAV export",
  "author": "DJ M@D",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-with-sidecar.ps1",
    "dev:web": "next dev",
    "debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-with-sidecar.ps1 -Inspect",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:vocal": "node scripts/run-e2e-vocal.cjs",
    "test:e2e:musicgen": "node scripts/run-e2e-musicgen.cjs",
    "test:e2e:musicgen:live": "node scripts/run-e2e-musicgen.cjs --live",
    "test:e2e:subset": "node scripts/run-e2e-subset.cjs",
    "test:smoke": "node scripts/run-sidecar-smoke.cjs",
    "test:smoke:stems": "node scripts/run-sidecar-smoke-stems.cjs",
    "test:smoke:vocal": "node scripts/run-sidecar-smoke-vocal.cjs",
    "test:smoke:generate": "node scripts/run-sidecar-smoke-generate.cjs",
    "sync:suno-catalog": "node scripts/sync-suno-catalog.cjs",
    "import:awesome-suno": "node scripts/import-awesome-suno-concepts.cjs",
    "sync:version": "node scripts/sync-product-version.cjs",
    "docs:panels": "node scripts/generate-panel-inventory.cjs",
    "prebuild": "node scripts/sync-product-version.cjs",
    "bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-toolchains.ps1",
    "bootstrap:buildtools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-toolchains.ps1 -WithBuildTools",
    "sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-sidecar.ps1",
    "sidecar:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-sidecar.ps1",
    "sidecar:stems": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-stems.ps1",
    "sidecar:stems-melband": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-stems-melband.ps1",
    "sidecar:cuda": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-cuda.ps1",
    "sidecar:vocal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-vocal.ps1",
    "sidecar:vocal-ml": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-vocal-ml.ps1",
    "sidecar:vocal-rvc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-vocal-rvc.ps1",
    "sidecar:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-generate.ps1",
    "sidecar:vision": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-vision.ps1",
    "sidecar:cover": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-cover.ps1",
    "sidecar:cover-ref": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-cover-ref.ps1",
    "sidecar:classify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-classify.ps1",
    "sidecar:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sidecar-all.ps1",
    "sidecar:fg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-sidecar.ps1 -Foreground -IdleExitSec 0",
    "sidecar:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-with-sidecar.ps1 -WatchOnly",
    "sidecar:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-sidecar.ps1",
    "sidecar:mcp": "py -3.10 ai-sidecar/ai_sidecar/mcp_stdio.py",
    "build:sidecar": "node scripts/build-sidecar-bundle.cjs",
    "build:sidecar-resources": "node scripts/build-sidecar-resources.cjs",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-sidecar-binary.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-with-sidecar.ps1 -Tauri",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-sidecar-binary.ps1 && cd src-tauri && cargo tauri build",
    "check": "npm run test && npm run lint && npm run build",
    "test:sidecar": "node scripts/run-pytest-sidecar.cjs",
    "check:full": "node scripts/run-check-full.cjs",
    "check:full:e2e": "node scripts/run-check-full.cjs --e2e",
    "check:full:e2e:subset": "node scripts/run-check-full.cjs --e2e-subset",
    "check:rust-locks": "node scripts/verify-rust-locks.cjs",
    "check:ci": "node scripts/run-ci-gates.cjs",
    "check:ci:e2e-subset": "node scripts/run-ci-gates.cjs --e2e-subset",
    "hooks:install": "node scripts/install-git-hooks.cjs",
    "sourcery:fetch": "node scripts/fetch-sourcery-review.cjs",
    "sourcery:auto": "node scripts/sourcery-auto-fix-agent.cjs",
    "sourcery:install-cursor": "node scripts/install-sourcery-cursor-setting.cjs",
    "fail-safe:run": "node scripts/fail-safe-bot.cjs",
    "fail-safe:fetch-ci": "node scripts/fetch-ci-failure.cjs",
    "fail-safe:auto": "node scripts/fail-safe-bot-agent.cjs",
    "fail-safe:install-cursor": "node scripts/install-fail-safe-cursor-setting.cjs",
    "architecture:install-cursor": "node scripts/install-architecture-cursor-setting.cjs",
    "fail-safe:fix-push": "node scripts/fail-safe-fix-and-push.cjs",
    "fail-safe:fix-push:cloud": "node scripts/fail-safe-cloud-dispatch.cjs",
    "fail-safe:pr-autofix": "node scripts/fail-safe-pr-autofix.cjs",
    "fail-safe-ops": "node fail-safe-ops/bin/fail-safe-ops.cjs",
    "fail-safe-ops:diagnose": "node fail-safe-ops/bin/fail-safe-ops.cjs diagnose",
    "fail-safe-ops:ui": "node fail-safe-ops/bin/fail-safe-ops-ui.cjs",
    "fail-safe:runtime-deliver": "node scripts/fail-safe-runtime-deliver.cjs",
    "bots:install": "node scripts/install-cursor-bot-settings.cjs",
    "sidecar:maintainer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-sidecar.ps1 -Maintainer",
    "ship:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ship-preflight.ps1",
    "ship:ready": "node scripts/ship-ready.cjs",
    "ship:ready:full": "node scripts/ship-ready.cjs --full",
    "ship:tag": "node scripts/ship-tag-release.cjs",
    "build": "next build",
    "postbuild": "node scripts/verify-lazy-catalog-chunks.cjs",
    "build:readme-pdf": "node scripts/generate-readme-pdf.cjs"
  },
  "dependencies": {
    "lamejs": "^1.2.1",
    "next": "16.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "wavesurfer.js": "^7.12.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "pdfkit": "^0.19.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
